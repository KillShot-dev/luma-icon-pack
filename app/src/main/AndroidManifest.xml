<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Normal permission, no runtime request needed. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <queries>
        <package android:name="com.teslacoilsw.launcher" />
        <package android:name="com.actionlauncher.playstore" />
        <package android:name="org.adw.launcher" />
        <package android:name="com.anddoes.launcher" />
        <package android:name="ch.deletescape.lawnchair.plah" />
        <package android:name="app.lawnchair" />
        <package android:name="app.lawnchair.play" />
        <package android:name="bitpit.launcher" />
        <package android:name="ginlemon.flowerfree" />
        <package android:name="projekt.launcher" />
        <package android:name="com.mi.android.globallauncher" />
        <package android:name="com.microsoft.launcher" />
        <package android:name="com.metaphasicgroup.luma.regular" />
        <package android:name="com.metaphasicgroup.luma.dark" />
        <package android:name="com.metaphasicgroup.luma.gradient" />
        <package android:name="com.metaphasicgroup.luma.glyph" />
        <package android:name="com.metaphasicgroup.luma.clear" />
        <package android:name="com.metaphasicgroup.luma.prism" />
        <package android:name="com.metaphasicgroup.luma.midnight" />
    </queries>
    <application android:allowBackup="true" android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Icon-pack discovery: the theme intent actions launchers
                 query when listing installed packs. Nova, ADW, GO, Atom
                 and Smart Launcher each query their own action below;
                 Lawnchair finds packs through Nova's. Apex uses the
                 separate filter underneath (MAIN + its THEME category,
                 the form reference packs ship). Microsoft Launcher's
                 query is closed-source and unverified. Without these,
                 no launcher picker can list Luma at all. -->
            <intent-filter>
                <action android:name="com.novalauncher.THEME" />
                <action android:name="org.adw.launcher.THEMES" />
                <action android:name="com.gau.go.launcherex.theme" />
                <action android:name="com.dlto.atom.launcher.THEME" />
                <action android:name="ginlemon.smartlauncher.THEMES" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.novalauncher.category.CUSTOM_ICON_PICKER" />
            </intent-filter>
            <!-- Apex Launcher discovery: MAIN action + Apex THEME category. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.anddoes.launcher.THEME" />
            </intent-filter>
            <!-- Nova per-icon picker: MAIN action + picker category. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.novalauncher.category.CUSTOM_ICON_PICKER" />
            </intent-filter>
        </activity>
        <!-- Widgets (clock + search).
             exported="true" is required: since API 31 every component with
             an intent filter must declare it, and a widget receiver must
             be exported so the host can deliver APPWIDGET_UPDATE. -->
        <receiver android:name=".ClockWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/clock_widget_info" />
        </receiver>
        <receiver android:name=".SearchWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/search_widget_info" />
        </receiver>
    </application>
</manifest>
