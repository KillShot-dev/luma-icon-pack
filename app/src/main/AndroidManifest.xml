<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Phase 6: normal permission, no runtime request needed. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <queries>
        <package android:name="com.teslacoilsw.launcher" />
        <package android:name="com.actionlauncher.playstore" />
        <package android:name="org.adw.launcher" />
        <package android:name="com.anddoes.launcher" />
        <package android:name="ch.deletescape.lawnchair.plah" />
        <package android:name="app.lawnchair" />
        <package android:name="app.lawnchair.play" />
        <package android:name="bitpit.launcher" />
        <package android:name="ginlemon.flowerfree" />
        <package android:name="projekt.launcher" />
        <package android:name="com.mi.android.globallauncher" />
        <package android:name="com.microsoft.launcher" />
        <package android:name="com.metaphasicgroup.luma.regular" />
        <package android:name="com.metaphasicgroup.luma.dark" />
        <package android:name="com.metaphasicgroup.luma.gradient" />
        <package android:name="com.metaphasicgroup.luma.glyph" />
        <package android:name="com.metaphasicgroup.luma.clear" />
        <package android:name="com.metaphasicgroup.luma.prism" />
        <package android:name="com.metaphasicgroup.luma.midnight" />
    </queries>
    <application android:allowBackup="true" android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Phase 6 widgets (from phase6-staging/MANIFEST_SNIPPET.xml; the
             snippet's standalone xmlns declaration is dropped on merge).
             exported="true" is required: since API 31 every component with
             an intent filter must declare it, and a widget receiver must
             be exported so the host can deliver APPWIDGET_UPDATE. -->
        <receiver android:name=".ClockWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/clock_widget_info" />
        </receiver>
        <receiver android:name=".SearchWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/search_widget_info" />
        </receiver>
    </application>
</manifest>
