<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared widget bar background — Phase 6 staging (original shape drawable).
  Translucent deep slate #141821 at ~80% opacity (alpha CC), so the home
  wallpaper shows through faintly, with a 1dp icy-blue #7DD3FC edge at ~20%
  opacity (alpha 33) for the luminous Luma edge. 20dp corners: a soft rounded
  rectangle on the 110dp clock bar, and a near-pill on the 40dp search bar
  (where the host clips it to the bar height).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#CC141821" />
    <stroke
        android:width="1dp"
        android:color="#337DD3FC" />
    <corners android:radius="20dp" />
</shape>
