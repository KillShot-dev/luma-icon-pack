<?xml version="1.0" encoding="utf-8"?>
<!--
  Luma search widget layout — RemoteViews-safe only: FrameLayout, LinearLayout,
  ImageView, TextView. No custom views, no EditText: a widget cannot host an
  input field, so this is a tappable bar with a magnifier glyph and a
  "Search" hint (literal text, no new string resource required).
  Magnifier is tinted icy blue #7DD3FC; hint text is light slate #CBD5E1;
  the bar uses the shared translucent deep-slate background.
  The whole bar is tappable (id referenced by SearchWidgetProvider).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bar_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_search_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Search"
            android:src="@drawable/search_ic_magnifier"
            android:tint="#7DD3FC" />

        <TextView
            android:id="@+id/widget_search_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Search"
            android:textColor="#CBD5E1"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>
