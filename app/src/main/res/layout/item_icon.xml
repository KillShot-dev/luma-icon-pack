<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center" android:padding="6dp">
    <ImageView android:id="@+id/item_icon" android:layout_width="56dp" android:layout_height="56dp" />
    <TextView android:id="@+id/item_label" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:textSize="11sp"
        android:textColor="#E8EDF5" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
