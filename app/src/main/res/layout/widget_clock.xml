<?xml version="1.0" encoding="utf-8"?>
<!--
  Luma clock widget layout — RemoteViews-safe only: FrameLayout, LinearLayout,
  TextClock. No custom views, no EditText, no Button.
  TextClock honors the system 12/24-hour setting; both patterns are declared.
  Time is platinum #E8EDF5, date is icy-blue #7DD3FC, on the shared
  translucent deep-slate bar background (#141821 at ~80% opacity).
  The whole bar is tappable (id referenced by ClockWidgetProvider).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bar_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/widget_clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#E8EDF5"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/widget_clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:format12Hour="EEEE, MMMM d"
            android:format24Hour="EEEE, MMMM d"
            android:textColor="#7DD3FC"
            android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>
